{
  "name": "@cellary/cli",
  "version": "0.0.1",
  "private": true,
  "description": "CLI for cellary -- your SIM card as an API",
  "type": "module",
  "bin": {
    "cellary": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test:integration": "vitest run -c vitest.integration.config.ts"
  },
  "dependencies": {
    "@cellary/daemon": "workspace:*",
    "better-sqlite3": "^12.6.2",
    "citty": "^0.1.6",
    "ink": "^6.0.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "react": "^19.0.0",
    "cellary": "workspace:*",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.3",
    "@types/pino-pretty": "^5.0.0",
    "@types/react": "^19.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
