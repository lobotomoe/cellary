{
  "name": "cellary",
  "version": "0.0.1",
  "private": true,
  "description": "Your SIM card as an API",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.1",
    "serialport": "^12.0.0",
    "tcpip": "^0.3.6",
    "usb": "^2.18.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^25.9.5",
    "tsup": "^8.5.1",
    "vitest": "^3.2.7"
  },
  "keywords": [
    "modem",
    "cellular",
    "at-commands",
    "sms",
    "gsm",
    "lte",
    "sim",
    "telecom",
    "ril"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lobotomoe/cellary",
    "directory": "packages/core"
  }
}
