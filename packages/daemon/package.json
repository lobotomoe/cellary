{
  "name": "@cellary/daemon",
  "version": "0.0.1",
  "private": true,
  "description": "Privileged USB daemon for cellary",
  "type": "module",
  "bin": {
    "cellaryd": "./dist/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "import": "./dist/main.js"
    },
    "./client": {
      "types": "./dist/ipc/client.d.ts",
      "import": "./dist/ipc/client.js"
    },
    "./audit": {
      "types": "./dist/audit.d.ts",
      "import": "./dist/audit.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "cellary": "workspace:*",
    "pino": "^10.3.1",
    "superjson": "^2.2.6",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^25.9.5",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
