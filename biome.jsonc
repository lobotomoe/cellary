{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": ["packages/*/src/**", "packages/*/test/**"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedVariables": "error",
        "noUnusedImports": "error",
        "noUndeclaredDependencies": "error"
      },
      "nursery": {
        "noFloatingPromises": "error",
        "noMisusedPromises": "error",
        "useAwaitThenable": "error",
        "useExhaustiveSwitchCases": "error"
      },
      "performance": {
        "noAccumulatingSpread": "error"
      },
      "style": {
        "useConsistentArrayType": "error",
        "noNonNullAssertion": "error",
        "noNestedTernary": "error",
        "noParameterAssign": "error",
        "useExplicitLengthCheck": "error",
        "useForOf": "error",
        "useThrowNewError": "error",
        "useThrowOnlyError": "error",
        "useErrorCause": "error"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noEvolvingTypes": "error",
        "noUnsafeDeclarationMerging": "off",
        "useErrorMessage": "error",
        "noImportCycles": {
          "level": "error",
          "options": {
            "ignoreTypes": false
          }
        },
        "noNestedPromises": "error",
        "noShadow": "error",
        // Off because Biome 2.5's type inference for this rule is unsound
        // against this codebase: it reports `RegExp.exec()` results as never
        // null, ignores `noUncheckedIndexedAccess` on record lookups, and reads
        // a mutable class field initialised to `false` as the literal `false`.
        // Every one of its 53 findings on 2.5.12 was a false positive.
        // Re-enable once a Biome release fixes the inference.
        "noUnnecessaryConditions": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "all",
      "semicolons": "asNeeded"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
